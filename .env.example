# Primary LLM Provider: "groq" (default)
LLM_PROVIDER=groq

# Groq (GroqCloud - LPU) Configuration - Default LLM
GROQ_API_KEY=gsk_your_actual_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Grok (xAI) Configuration (optional)
GROK_API_KEY=
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# Embeddings / Optional OpenAI Fallback
OPENAI_API_KEY=

# Tavily Search API (optional bonus fallback)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Storage & Server Configuration
CHROMA_PERSIST_DIRECTORY=./backend/data/chroma
PORT=8000
ANONYMIZED_TELEMETRY=False
